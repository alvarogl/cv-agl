---
import meImage from '../assets/me.png';
import { Image } from 'astro:assets';
import resumeData from '../data/me.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactIcon from './ContactIcon.astro';

const { site, contact } = resumeData;
const contactItems = [
  { icon: 'email', label: 'Email', href: `mailto:${contact.email}`, value: contact.email },
  { icon: 'linkedin', label: 'LinkedIn', href: contact.linkedin.link, value: contact.linkedin.text },
  { icon: 'github', label: 'GitHub', href: contact.github.link, value: contact.github.text },
  { icon: 'website', label: 'Website', href: contact.web.link, value: contact.web.text }
];
---

<BaseLayout meta={site.meta}>
  <div class="page-shell">
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">AG</span>
        <span>{contact.name}</span>
      </a>

      <nav class="section-nav" aria-label="Section navigation">
        <a href="#summary">{site.nav.summary}</a>
        <a href="#experience">{site.nav.experience}</a>
        <a href="#skills">{site.nav.skills}</a>
        <a href="#contact">{site.nav.contact}</a>
      </nav>
    </header>

    <main class="content-grid">
      <section class="hero-card">
        <div class="hero-copy">
          <div class="status-line"><span class="status-dot"></span>{site.hero.availability}</div>
          <p class="eyebrow">{contact.tagline} · {contact.location}</p>
          <h1>{site.hero.titleLead} <em>{site.hero.titleAccent}</em> {site.hero.titleTail}</h1>
          <p class="hero-summary">{site.hero.description}</p>

          <div class="hero-actions">
            <a class="button button-primary" href="#contact">{site.hero.primaryCta}</a>
            <a class="button button-secondary" href="#experience">{site.hero.secondaryCta}</a>
          </div>

          <div class="proof-points" aria-label="Career highlights">
            <div><strong>Java</strong><span>backend<br />systems</span></div>
            <div><strong>AWS</strong><span>cloud and<br />integration work</span></div>
            <div><strong>EU</strong><span>remote-ready<br />collaboration</span></div>
          </div>
        </div>

        <div class="hero-visual">
          <span class="visual-label">Currently at<br /><strong>Sngular</strong></span>
          <div class="portrait-frame">
            <Image src={meImage} alt={contact.name} widths={[480, 640]} sizes="(max-width: 768px) 230px, 280px" />
          </div>
          <span class="visual-caption">Backend · APIs · Platform</span>
        </div>
      </section>

      <aside class="sidebar-card" id="summary">
        <div class="section-heading">
          <p class="eyebrow">{site.summary.eyebrow}</p>
          <h2>{site.summary.title}</h2>
        </div>

        <p class="section-text">{resumeData.about.content}</p>

        <ul class="fact-list">
          {site.summary.highlights.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      </aside>

      <section class="content-card section-card" id="experience">
        <div class="section-heading">
          <div class="section-kicker"><p class="eyebrow">{site.experience.eyebrow}</p><span>2014 — now</span></div>
          <h2>{site.experience.title}</h2>
          <p class="section-note">{site.experience.note}</p>
        </div>

        <div class="timeline">
          {resumeData.experiences.map((experience) => (
            <article class="timeline-item">
              <div class="timeline-meta">
                <p class="timeline-period">{experience.time}</p>
                <h3>{experience.job_title}</h3>
                <p class="timeline-company">{experience.company}</p>
              </div>

              <div class="timeline-content">
                {experience.details.responsibilities.map((responsibility) => (
                  <div class="responsibility-block">
                    {responsibility.head && <p class="responsibility-head">{responsibility.head}</p>}
                    <ul>
                      {responsibility.elements.map((element) => (
                        <li>{element}</li>
                      ))}
                    </ul>
                  </div>
                ))}

                <section class="technology-section" aria-label={site.experience.technologies}>
                  <h4>{site.experience.technologies}</h4>
                  <p>{experience.technologies.join(' · ')}</p>
                </section>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="content-card section-card" id="skills">
        <div class="section-heading">
          <p class="eyebrow">{site.skills.eyebrow}</p>
          <h2>{site.skills.title}</h2>
          <p class="section-note">{site.skills.note}</p>
        </div>

        <div class="skills-grid">
          {resumeData.skills.map((skill) => (
            <article class="skill-card">
              <div class="skill-header">
                <h3>{skill.name}</h3>
                <span>{skill.proficiency}%</span>
              </div>
              <div class="skill-bar" aria-hidden="true">
                <span style={`width: ${skill.proficiency}%`}></span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="content-card section-card contact-card" id="contact">
        <div class="section-heading">
          <p class="eyebrow">{site.contact.eyebrow}</p>
          <h2>{site.contact.title}</h2>
          <p class="section-note">{site.contact.intro}</p>
        </div>

        <div class="contact-grid">
          {contactItems.map((item) => (
            <a class="contact-item" href={item.href} target={item.href.startsWith('mailto:') ? undefined : '_blank'} rel={item.href.startsWith('mailto:') ? undefined : 'noreferrer'}>
              <span class="contact-icon"><ContactIcon type={item.icon} /></span>
              <span class="contact-label">{item.label}</span>
              <strong>{item.value}</strong>
            </a>
          ))}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
