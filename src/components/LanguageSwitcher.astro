---
const { locale, labels } = Astro.props;
const englishPath = '/';
const spanishPath = '/es/';
---

<div class="language-switcher" aria-label={labels.language.label}>
  <span>{labels.language.label}</span>
  <a href={englishPath} class:list={{ active: locale === 'en' }}>{labels.language.english}</a>
  <a href={spanishPath} class:list={{ active: locale === 'es' }}>{labels.language.spanish}</a>
</div>
